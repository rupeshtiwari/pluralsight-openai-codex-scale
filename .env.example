# SupportHub demo environment.
# Copy to .env.local and fill in. Never commit .env or .env.local.

# --- Sentry ---------------------------------------------------------------
# SENTRY_DSN sends application errors INTO Sentry from the running service.
SENTRY_DSN=
# SENTRY_AUTH_TOKEN is a read-only API token used to LOOK UP issues.
# These two do different jobs. Neither value is ever printed on screen.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_BASE_URL=https://sentry.io

# --- Slack ----------------------------------------------------------------
SLACK_DEMO_CHANNEL=#supporthub-demo

# --- Linear ---------------------------------------------------------------
LINEAR_DEMO_TEAM=
LINEAR_DEMO_PROJECT=

# --- GitHub ---------------------------------------------------------------
GITHUB_DEMO_REPO=rupeshtiwari/pluralsight-openai-codex-scale
