{
  "name": "supporthub",
  "version": "1.0.0",
  "private": true,
  "description": "SupportHub - demo repository for the Pluralsight course OpenAI Codex at Scale",
  "workspaces": [
    "supporthub-api/modern",
    "supporthub-api/migration"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "npm run lint --workspace=supporthub-api/modern",
    "typecheck": "npm run typecheck --workspace=supporthub-api/modern",
    "build": "npm run build --workspace=supporthub-api/modern",
    "test": "npm run test --workspace=supporthub-api/modern",
    "test:route": "npm run test:route --workspace=supporthub-api/modern",
    "lint:migration": "npm run lint --workspace=supporthub-api/migration",
    "typecheck:migration": "npm run typecheck --workspace=supporthub-api/migration",
    "build:migration": "npm run build --workspace=supporthub-api/migration",
    "test:migration": "npm run test --workspace=supporthub-api/migration",
    "check:negatives": "node scripts/check-negatives.mjs",
    "lint:md": "markdownlint-cli2 plans/ExecPlan.md plans/migration-plan.md && cspell --no-progress --no-summary \"module1/*.md\" \"module2/*.md\" \"docs/*.md\" README.md"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.18.1",
    "cspell": "^10.1.1"
  }
}
